FROM golang:1.27.2-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /out/devdocs-api ./cmd/api
FROM alpine:3.23
RUN apk add --no-cache ca-certificates && addgroup -S devdocs && adduser -S -G devdocs devdocs
WORKDIR /app
COPY --from=build /out/devdocs-api /usr/local/bin/devdocs-api
COPY db/migrations /app/db/migrations
USER devdocs
EXPOSE 8081
ENTRYPOINT ["devdocs-api"]
